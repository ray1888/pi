{
  "name": "pi-ops-agent-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "用 @earendil-works/pi-agent-core 1.5.2 跑通的只读模拟运维 agent。默认不访问模型 API，也不访问集群。",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "demo": "tsx src/cli.ts",
    "traces": "tsx src/cli.ts --write-examples",
    "test": "tsx --test test/*.test.ts",
    "investigate": "tsx src/cli.ts --investigate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
